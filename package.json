{
  "name": "cell-anatomy-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D Cell Anatomy Explorer (Animal vs. Plant) - educational static web app built with procedural Three.js geometry.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:sizes": "node verify/size-audit.mjs",
    "audit:models": "node verify/model-audit.mjs",
    "perf": "node verify/perf-report.mjs",
    "verify": "npm run build && npm run audit:models && npm run audit:sizes && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "alea": "^1.0.1",
    "gsap": "^3.15.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
